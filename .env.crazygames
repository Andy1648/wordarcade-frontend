# Loaded by Vite ONLY for `--mode crazygames` (npm run build:crazygames). The CrazyGames zip is the portal
# build (VITE_PORTAL skips the intro chain and keeps the URL as launched) plus VITE_PLATFORM, which turns on the
# CrazyGames SDK glue in src/platform/crazygames.js. The default `vite build` never reads this file.
# Supabase (leaderboard / cloud save): put VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY (the same public values the
# production bundle ships) in .env.crazygames.local (gitignored) or the shell env before building.
VITE_PORTAL=1
VITE_PLATFORM=crazygames
